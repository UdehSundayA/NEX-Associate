# Copy this file to .env in the same folder and fill in real values.

# Base URL of the nex-curriculum backend this proxy calls.
NEX_CURRICULUM_API_URL=http://localhost:3000

# Must match nex-curriculum's own INTERNAL_API_KEY env var — every request
# to nex-curriculum is rejected with 401 without this.
NEX_INTERNAL_API_KEY=

# Optional — only needed if nex-curriculum's INTERNAL_SERVICE_TOKEN is set.
NEX_INTERNAL_SERVICE_TOKEN=
